{
  "name": "evenkit-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "predev": "npm run build:packages",
    "dev": "npm run dev --workspace @evenkit/catalog",
    "build:packages": "npm run build --workspace @evenkit/tokens && npm run build --workspace @evenkit/ui",
    "build": "npm run build:packages && npm run build --workspace @evenkit/catalog",
    "typecheck": "tsc -p tsconfig.checks.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "verify": "npm run build && npm run typecheck && npm run lint && npm test && npm run test:browser",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify:examples": "node scripts/verify-catalog-examples.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/d3-shape": "3.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "globals": "^17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
