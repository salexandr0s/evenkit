{
  "name": "@evenkit/auth-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Opt-in Supabase authentication adapter for Next applications.",
  "files": ["dist", "README.md", "PROVENANCE.md", "licenses"],
  "exports": {
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js" },
    "./paths": { "types": "./dist/paths.d.ts", "import": "./dist/paths.js" },
    "./policy": { "types": "./dist/policy.d.ts", "import": "./dist/policy.js" }
  },
  "sideEffects": ["./dist/server.js"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.json --noEmit" },
  "dependencies": { "@supabase/ssr": "0.12.7", "@supabase/supabase-js": "2.118.0", "server-only": "0.0.1", "zod": "4.6.7" },
  "peerDependencies": { "next": "^16.4.3" },
  "devDependencies": { "next": "16.4.3" }
}
