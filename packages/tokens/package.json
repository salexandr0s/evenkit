{
  "name": "@evenkit/tokens",
  "version": "0.1.0",
  "description": "Validated design tokens and document themes for Evenkit.",
  "type": "module",
  "license": "UNLICENSED",
  "files": ["dist", "README.md", "PROVENANCE.md"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./css": { "types": "./dist/tokens-css.d.ts", "default": "./dist/tokens.css" },
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/generate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "zod": "4.6.7" },
  "engines": { "node": ">=22.12.0" }
}
